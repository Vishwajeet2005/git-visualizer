# ─────────────────────────────────────────────────────────────────────────────
# Nexus Repository Context Engine — Environment Variables
# Copy this file to .env and fill in all values before running docker-compose.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Strong random password; min 32 chars recommended
POSTGRES_PASSWORD=change_me_strong_password_32chars

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_API_KEY=change_me_qdrant_api_key

# ── AES-256-GCM token encryption ───────────────────────────────────────────────
# Generate with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
AES_SECRET_KEY=BASE64_ENCODED_32_BYTE_KEY_HERE

# ── GitHub OAuth App ────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps
# Callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ── AI / LLM Providers ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Which model to use for inference (cloud path)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-opus-4-6

# ── Embedding provider: "openai" or "local" ────────────────────────────────────
EMBED_PROVIDER=openai
# Only used when EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# ── Ollama / Local SLM ──────────────────────────────────────────────────────────
# If running Ollama as a separate service or sidecar
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# ── Frontend URLs ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Celery Flower auth ──────────────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=change_me_flower_password

# ── Grafana ─────────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password
GRAFANA_URL=http://localhost:3001
